{
  "dependencies": {
    "cypress": "^14.4.1"
  },
  "scripts": {
    "test:report": "cypress run && mochawesome-merge cypress/results/*.json > mochawesome-report.json && npx mochawesome-report-generator mochawesome-report.json --reportDir cypress/reports --inline",
    "clean:results": "rm -rf cypress/results/* && rm -rf cypress/reports/*"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^22.1.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.5",
    "@faker-js/faker": "^9.8.0",
    "@shelex/cypress-allure-plugin": "^2.41.2",
    "cypress-file-upload": "^5.0.8",
    "cypress-xpath": "^2.0.1",
    "esbuild": "^0.25.5",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.2.0"
  }
}
